# ============================================================
# ARCHIVO DE EJEMPLO - Copia como .env y personaliza
# ============================================================
# Instrucciones:
#   1. Copia este archivo: cp .env.example .env
#   2. Edita .env con tus valores reales
#   3. NUNCA subas el archivo .env a un repositorio publico

# ============================================================
# Credenciales AWS S3
# ============================================================
# Opcion A: configurarlas directamente aqui
# AWS_ACCESS_KEY_ID=tu_access_key_id
# AWS_SECRET_ACCESS_KEY=tu_secret_access_key
# AWS_REGION=us-east-1

# Opcion B: configurarlas como variables de entorno del sistema
# (setx AWS_ACCESS_KEY_ID "tu_key" en Windows)

# ============================================================
# Buckets S3 predefinidos (REQUERIDO)
# ============================================================
# Lista separada por comas de los buckets que apareceran en la app.
# Reemplaza con los nombres de TUS propios buckets S3.
S3_PREDEFINED_BUCKETS=mi-bucket-produccion,mi-bucket-staging,mi-bucket-dev

# ============================================================
# Configuracion del servidor
# ============================================================
HOST=0.0.0.0
PORT=8000
RELOAD=True

# ============================================================
# Configuracion de la aplicacion
# ============================================================
APP_NAME=S3 Parquet Explorer
DEBUG=true

# ============================================================
# Configuracion de logging
# ============================================================
LOG_LEVEL=INFO
